#!/usr/bin/env bash
# pp - ping-pong: an isolated two-party message channel between agent sessions.
#
# Two sessions (possibly on different machines) meet on a shared "bus" host and
# exchange messages through a private pair of FIFOs. Every channel is isolated:
# two channels never see each other's traffic.
#
# Operations are flags. The bare argument is ALWAYS the channel id.

set -uo pipefail

PP_VERSION="0.1.0"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ping-pong"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ping-pong"
BUS_ROOT="${PP_BUS_ROOT:-/tmp/ping-pong}"
SEND_TIMEOUT="${PP_SEND_TIMEOUT:-60}"

bus_mode=""
bus_ssh=""
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

die() { printf 'pp: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# ---------------------------------------------------------------- bus plumbing

need_config() {
  case "$bus_mode" in
    local) : ;;
    ssh) [ -n "$bus_ssh" ] || die "bus_mode=ssh but bus_ssh is empty in $CONFIG_FILE" ;;
    *) die "not configured yet.
    On the machine that HOSTS the bus:  pp --setup --bus-local
    On every other machine:             pp --setup --bus-ssh <ssh-alias>" ;;
  esac
}

# bus <snippet> - short remote/local command; stdin and stdout are forwarded
bus() {
  case "$bus_mode" in
    local) bash -c "$1" ;;
    ssh) ssh -o BatchMode=yes -o ConnectTimeout=10 "$bus_ssh" "$1" ;;
  esac
}

# bus_stream <snippet> - same, but for calls that block for a long time
bus_stream() {
  case "$bus_mode" in
    local) bash -c "$1" ;;
    ssh) ssh -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=1000 \
             "$bus_ssh" "$1" ;;
  esac
}

bus_label() {
  case "$bus_mode" in
    local) printf 'local' ;;
    ssh) printf 'ssh:%s' "$bus_ssh" ;;
  esac
}

# ------------------------------------------------------------------- utilities

gen_id() {
  local raw
  raw=$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'abcdefghijkmnpqrstuvwxyz23456789' | cut -c1-6)
  [ ${#raw} -eq 6 ] || die "could not generate a random id"
  printf 'pp-%s' "$raw"
}

valid_id() { [[ "${1:-}" =~ ^pp-[a-z0-9]{4,16}$ ]]; }

sanitize() { printf '%s' "${1:-}" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' | cut -c1-32; }

default_label() { sanitize "${PP_LABEL:-$(hostname -s 2>/dev/null || echo agent)}"; }

side_file() { printf '%s/%s.side' "$STATE_DIR" "$1"; }

my_side() {
  local id="$1"
  if [ -n "${PP_SIDE:-}" ]; then printf '%s' "$PP_SIDE"; return 0; fi
  local f; f=$(side_file "$id")
  [ -r "$f" ] || die "channel $id is not registered on this machine.
    If you opened it, you are on the wrong machine.
    If someone handed you the id, join first:  pp --join $id"
  tr -d '[:space:]' < "$f"
}

other_side() { [ "$1" = "a" ] && printf 'b' || printf 'a'; }

require_channel() {
  local id="$1"
  bus "test -p '$BUS_ROOT/$id/to-a' && test -p '$BUS_ROOT/$id/to-b'" \
    || die "channel $id does not exist on the bus ($(bus_label)).
    Check the id, or the bus rebooted - channels live in $BUS_ROOT and do not survive one.
    Open channels:  pp --list"
}

# ------------------------------------------------------------------- commands

cmd_setup() {
  mkdir -p "$CONFIG_DIR"
  case "${1:-}" in
    --bus-local)
      printf 'bus_mode=local\nbus_ssh=\n' > "$CONFIG_FILE"
      say "pp: this machine IS the bus. Config written to $CONFIG_FILE"
      ;;
    --bus-ssh)
      local alias="${2:-}"
      [ -n "$alias" ] || die "--bus-ssh needs the ssh alias of the bus host"
      printf 'bus_mode=ssh\nbus_ssh=%s\n' "$alias" > "$CONFIG_FILE"
      say "pp: bus is '$alias' over ssh. Config written to $CONFIG_FILE"
      ssh -o BatchMode=yes -o ConnectTimeout=10 "$alias" 'command -v mkfifo >/dev/null' \
        && say "pp: bus reachable, mkfifo present" \
        || say "pp: WARNING - could not reach '$alias', or it has no mkfifo"
      ;;
    *) die "usage: pp --setup --bus-local | pp --setup --bus-ssh <ssh-alias>" ;;
  esac
}

cmd_open() {
  local topic="$1" label="$2"
  need_config
  local id; id=$(gen_id)
  local created; created=$(date -u +%FT%TZ)

  printf 'id=%s\ncreated=%s\nside_a=%s\nside_b=\ntopic=%s\n' \
    "$id" "$created" "$label" "$topic" |
  bus "set -e
    umask 077
    mkdir -p '$BUS_ROOT'
    if [ ! -O '$BUS_ROOT' ]; then echo 'pp: $BUS_ROOT exists but is owned by someone else' >&2; exit 3; fi
    chmod 700 '$BUS_ROOT'
    mkdir -m 700 '$BUS_ROOT/$id'
    mkfifo -m 600 '$BUS_ROOT/$id/to-a' '$BUS_ROOT/$id/to-b'
    cat > '$BUS_ROOT/$id/meta'" || die "could not create the channel on the bus ($(bus_label))"

  mkdir -p "$STATE_DIR"
  printf 'a\n' > "$(side_file "$id")"

  say "Channel open: $id"
  say "  bus:   $(bus_label):$BUS_ROOT/$id"
  say "  me:    side a  (label: $label)"
  [ -n "$topic" ] && say "  topic: $topic"
  say ""
  say "Hand THIS line to the other session:"
  say "    /ping-pong $id"
  say ""
  say "Then keep your listener running IN THE BACKGROUND:"
  say "    pp --listen $id"
}

cmd_join() {
  local id="$1" label="$2"
  need_config
  valid_id "$id" || die "invalid id: '$id' (expected form: pp-xxxxxx)"
  require_channel "$id"

  bus "set -e
    sed -i 's/^side_b=.*/side_b=$label/' '$BUS_ROOT/$id/meta' 2>/dev/null || true" >/dev/null

  mkdir -p "$STATE_DIR"
  printf 'b\n' > "$(side_file "$id")"

  say "Joined channel: $id"
  say "  bus:   $(bus_label):$BUS_ROOT/$id"
  say "  me:    side b  (label: $label)"
  local topic
  topic=$(bus "sed -n 's/^topic=//p' '$BUS_ROOT/$id/meta' 2>/dev/null")
  [ -n "$topic" ] && say "  topic: $topic"
  say ""
  say "Now keep your listener running IN THE BACKGROUND:"
  say "    pp --listen $id"
}

# A reader blocked in open(2) on a FIFO does not hold a file descriptor yet, so
# fuser/lsof cannot see it. The listener therefore records an explicit marker and
# removes it on exit; that marker is the only reliable "someone is listening".
cmd_listen() {
  local id="$1" wait_for="$2" label="$3"
  need_config
  valid_id "$id" || die "invalid id: '$id'"
  local side; side=$(my_side "$id")
  require_channel "$id"

  local reader="cat '$BUS_ROOT/$id/to-$side'"
  [ "$wait_for" -gt 0 ] 2>/dev/null && reader="timeout $wait_for $reader"

  bus_stream "m='$BUS_ROOT/$id/listening-$side'
    printf '%s pid=%s since=%s\n' '$label' \"\$\$\" \"\$(date -u +%FT%TZ)\" > \"\$m\"
    trap 'rm -f \"\$m\"' EXIT INT TERM HUP
    $reader"
  local rc=$?

  if [ $rc -eq 124 ]; then
    say "pp: nothing arrived within ${wait_for}s (channel $id is still open)"
    exit 124
  fi
  return $rc
}

cmd_send() {
  local id="$1" body="$2" label="$3" force="$4"
  need_config
  valid_id "$id" || die "invalid id: '$id'"
  local side; side=$(my_side "$id")
  local out; out=$(other_side "$side")
  require_channel "$id"

  if [ "$force" != "1" ]; then
    bus "test -f '$BUS_ROOT/$id/listening-$out'" || die "side $out of channel $id has no listener.
    A send with no reader blocks until the timeout, so it was not attempted.
    Ask the other session to run:  pp --listen $id
    If you know it IS listening without pp (a raw cat leaves no marker), retry with:
      pp --send $id --force -m ...
    Note: --force blocks up to ${SEND_TIMEOUT}s and exits 124 if nobody reads."
  fi

  { printf '=== ping-pong %s | from: %s (side %s) | %s ===\n' \
      "$id" "$label" "$side" "$(date -u +%FT%TZ)"
    printf '%s\n' "$body"
  } | bus_stream "timeout $SEND_TIMEOUT cat > '$BUS_ROOT/$id/to-$out'"
  local rc=$?

  if [ $rc -eq 124 ]; then
    die "nobody is reading side $out of channel $id (timed out after ${SEND_TIMEOUT}s).
    The message was NOT delivered and was NOT stored.
    Ask the other session to run:  pp --listen $id   then send it again."
  fi
  [ $rc -eq 0 ] || die "send failed (rc=$rc) against the bus ($(bus_label))"
  say "pp: delivered to side $out of channel $id"
}

cmd_list() {
  need_config
  local out
  out=$(bus "for d in '$BUS_ROOT'/pp-*; do
      [ -d \"\$d\" ] || continue
      id=\$(basename \"\$d\")
      topic=\$(sed -n 's/^topic=//p' \"\$d/meta\" 2>/dev/null)
      a=\$(sed -n 's/^side_a=//p' \"\$d/meta\" 2>/dev/null)
      b=\$(sed -n 's/^side_b=//p' \"\$d/meta\" 2>/dev/null)
      created=\$(sed -n 's/^created=//p' \"\$d/meta\" 2>/dev/null)
      printf '%s\t%s <-> %s\t%s\t%s\n' \"\$id\" \"\${a:-?}\" \"\${b:--}\" \"\$created\" \"\$topic\"
    done" 2>/dev/null)

  if [ -z "$out" ]; then
    say "pp: no open channels on the bus ($(bus_label):$BUS_ROOT)"
    return 0
  fi
  say "Open channels on $(bus_label):$BUS_ROOT"
  printf '%s\n' "$out" | while IFS=$'\t' read -r id sides created topic; do
    local mine=""
    [ -r "$(side_file "$id")" ] && mine=" (me: side $(tr -d '[:space:]' < "$(side_file "$id")"))"
    printf '  %-12s %-24s %s%s\n' "$id" "$sides" "$created" "$mine"
    [ -n "$topic" ] && printf '  %-12s topic: %s\n' "" "$topic"
  done
}

cmd_info() {
  local id="$1"
  need_config
  valid_id "$id" || die "invalid id: '$id'"
  require_channel "$id"
  say "Channel $id  on $(bus_label):$BUS_ROOT/$id"
  bus "cat '$BUS_ROOT/$id/meta' 2>/dev/null" | sed 's/^/  /'
  local f; f=$(side_file "$id")
  if [ -r "$f" ]; then
    say "  this machine is side $(tr -d '[:space:]' < "$f")"
  else
    say "  this machine is NOT registered on the channel (run: pp --join $id)"
  fi
  local waiting
  waiting=$(bus "for s in a b; do
      m='$BUS_ROOT/$id/listening-'\$s
      if [ -f \"\$m\" ]; then echo \"side \$s: LISTENING (\$(cat \"\$m\"))\"; else echo \"side \$s: no listener\"; fi
    done" 2>/dev/null)
  [ -n "$waiting" ] && printf '%s\n' "$waiting" | sed 's/^/  /'
}

# Deleting a FIFO does NOT release a reader already blocked in open(2): the
# pending open keeps the inode alive. So before deleting, write a closing notice
# to every side that has a listener marker, so it exits cleanly.
cmd_close() {
  local id="$1"
  need_config
  valid_id "$id" || die "invalid id: '$id'"
  bus "for s in a b; do
      if [ -f '$BUS_ROOT/$id/listening-'\$s ]; then
        printf '=== ping-pong %s | the other side CLOSED this channel ===\n' '$id' |
          timeout 5 cat > '$BUS_ROOT/$id/to-'\$s 2>/dev/null || true
      fi
    done
    rm -rf '$BUS_ROOT/$id'" || die "could not delete the channel on the bus"
  rm -f "$(side_file "$id")"
  say "pp: channel $id closed and deleted from the bus (active listeners were notified)"
}

cmd_install() {
  local dest="$HOME/.local/bin/pp"
  mkdir -p "$HOME/.local/bin"
  cp -f "${BASH_SOURCE[0]}" "$dest" && chmod +x "$dest" \
    && say "pp: installed at $dest (v$PP_VERSION). Re-run after every plugin update." \
    || die "could not copy to $dest"
}

usage() {
  cat <<'EOF'
pp - ping-pong: an isolated message channel between two agent sessions.

  Operations are FLAGS. The bare argument is ALWAYS the channel id.

  pp --setup --bus-local          this machine hosts the bus
  pp --setup --bus-ssh <alias>    the bus is <alias>, reachable over ssh

  pp --open [--topic "..."]       open a channel, print the id to hand over
  pp --join <id>                  join an existing channel
  pp --listen <id>                BLOCK until ONE message arrives, print it, exit
  pp --send <id> -m "text"        send a message (or pipe it in, without -m)
  pp --list                       open channels on the bus
  pp --info <id>                  channel metadata and who is listening now
  pp --close <id>                 close and delete the channel

  --as <label>    signature on your messages (default: short hostname)
  --force         send even if no listener is detected (blocks up to the timeout)
  --wait N        with --listen: give up after N seconds, exit 124

  --install       copy this script to ~/.local/bin/pp
  -h, --help      this help
  -V, --version   version

  Env: PP_BUS_ROOT (default /tmp/ping-pong), PP_SEND_TIMEOUT (60),
       PP_LABEL, PP_SIDE (force side a|b, for driving both ends from one machine).

  GOLDEN RULE: after receiving a message, relaunch --listen BEFORE you reply.
EOF
}

# ---------------------------------------------------------------------- parser

op="" id="" topic="" body="" label="" wait_for=0 force=0
setup_args=()

while [ $# -gt 0 ]; do
  case "$1" in
    -o|--open) op="open" ;;
    -j|--join) op="join" ;;
    -L|--listen) op="listen" ;;
    -s|--send) op="send" ;;
    -l|--list) op="list" ;;
    -i|--info) op="info" ;;
    -c|--close) op="close" ;;
    --setup) op="setup" ;;
    --install) op="install" ;;
    --bus-local|--bus-ssh) setup_args+=("$1") ;;
    -t|--topic) shift; topic="${1:-}" ;;
    -m|--message) shift; body="${1:-}" ;;
    -a|--as) shift; label="$(sanitize "${1:-}")" ;;
    -w|--wait) shift; wait_for="${1:-0}" ;;
    -f|--force) force=1 ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) say "pp $PP_VERSION"; exit 0 ;;
    -*) die "unknown flag: $1  (pp --help)" ;;
    *) if [ -z "$id" ]; then id="$1"; else setup_args+=("$1"); fi ;;
  esac
  shift
done

[ -n "$label" ] || label=$(default_label)

case "$op" in
  setup) cmd_setup "${setup_args[@]:-}" "${id:-}" ;;
  install) cmd_install ;;
  open) cmd_open "$topic" "$label" ;;
  join) [ -n "$id" ] || die "--join needs the channel id"; cmd_join "$id" "$label" ;;
  listen) [ -n "$id" ] || die "--listen needs the channel id"; cmd_listen "$id" "$wait_for" "$label" ;;
  send)
    [ -n "$id" ] || die "--send needs the channel id"
    if [ -z "$body" ]; then
      [ -t 0 ] && die "--send without -m needs the message on stdin"
      body=$(cat)
    fi
    cmd_send "$id" "$body" "$label" "$force"
    ;;
  list) cmd_list ;;
  info) [ -n "$id" ] || die "--info needs the channel id"; cmd_info "$id" ;;
  close) [ -n "$id" ] || die "--close needs the channel id"; cmd_close "$id" ;;
  "") usage; exit 1 ;;
  *) die "operation not implemented: $op" ;;
esac
